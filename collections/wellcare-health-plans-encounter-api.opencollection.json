{
  "opencollection": "1.0.0",
  "info": {
    "name": "WellCare FHIR Patient Access Condition Encounter API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Encounter",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Encounters",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://partners.centene.com/fhir/r4/Encounter",
            "params": [
              {
                "name": "patient",
                "value": "",
                "type": "query",
                "description": "The FHIR Patient ID."
              },
              {
                "name": "date",
                "value": "",
                "type": "query",
                "description": "Filter by encounter date range."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://partners.centene.com/oauth2/authorize",
              "accessTokenUrl": "https://partners.centene.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves Encounter resources representing care encounters, visits, and admissions for an authenticated member, including encounter type, date, provider, and location."
        }
      ]
    }
  ],
  "bundled": true
}