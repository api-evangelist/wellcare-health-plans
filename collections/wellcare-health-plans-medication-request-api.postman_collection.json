                  "value": "<string>",
                  "description": "(Required) The FHIR Patient ID."
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Filter by medication request status (active, completed, stopped)."
                }
              ],
              "variable": []
            },
