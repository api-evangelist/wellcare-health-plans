{
  "opencollection": "1.0.0",
  "info": {
    "name": "WellCare FHIR Patient Access Condition Location API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Location",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search Locations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://partners.centene.com/fhir/r4/Location",
            "params": [
              {
                "name": "address-postalcode",
                "value": "",
                "type": "query",
                "description": "ZIP code for location search."
              },
              {
                "name": "near",
                "value": "",
                "type": "query",
                "description": "Coordinate-based proximity search (latitude|longitude|distance|units)."
              },
              {
                "name": "_count",
                "value": "",
                "type": "query",
                "description": "Number of results per page."
              }
            ]
          },
          "docs": "Searches for care delivery locations by address, ZIP code, or proximity to a given coordinate. Returns location details, hours, accessibility, and available services."
        }
      ]
    }
  ],
  "bundled": true
}